{
  "name": "legalease-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for LegalEase AI",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "dev": "genkit start -- npx tsx --watch src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.14.0",
    "@genkit-ai/google-genai": "^1.14.0",
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/storage": "^7.14.0",
    "@google/genai": "^1.31.0",
    "@qdrant/js-client-rest": "^1.16.1",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "genkit": "^1.14.0",
    "genkitx-anthropic": "^0.26.0",
    "genkitx-openai": "^0.26.0",
    "google-auth-library": "^9.15.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "brace-expansion@2": "^2.1.7",
    "fast-uri": "^3.1.8",
    "fast-xml-parser@4": "^4.5.6",
    "form-data@2": "^2.5.6",
    "form-data@4": "^4.0.6",
    "handlebars": "^4.7.9",
    "minimatch@9": "^9.0.7",
    "path-to-regexp@0.1": "^0.1.13",
    "protobufjs@7": "^7.6.6",
    "undici@6": "^6.28.1",
    "websocket-driver": "^0.7.5",
    "ws@8": "^8.21.0",
    "protobufjs@8": "^8.6.6"
  }
}
