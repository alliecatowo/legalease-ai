{
  "name": "legalease",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Legal document analysis platform",
  "private": true,
  "scripts": {
    "firebase": "firebase",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "firebase:deploy": "firebase deploy",
    "firebase:emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-legalease-rules \"vitest run tests/rules\""
  },
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "basic-ftp@<6.2.1": "^6.2.1"
    }
  }
}
